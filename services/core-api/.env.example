[TEMPLATE]
# Copy to .env and adjust values per environment.
# This file is committed — non-sensitive dev defaults only. Real secrets
# (below) belong in services/core-api/.env.local instead (gitignored,
# loaded as an optional overlay by infra/docker-compose.yml). Never put a
# real API key or credential in this file or in .env — see the README's
# "Personal secrets" section for why.

PROJECT_NAME="DECODING JOBS Core API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://decoding_admin:decoding_pass_dev@postgis:5432/decoding_jobs

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3333,http://127.0.0.1:3333

# ---------------------------------------------------------------------------
# Everything below is a SECRET — put real values in .env.local, not here.
# ---------------------------------------------------------------------------

# Shared free-tier LLM key (optional — every feature below stays inert if unset,
# never errors): email-based interview round detection, the AI Assistant chat,
# and resume ATS scoring. Sign up free at https://console.groq.com — no paid
# API key needed. Get your OWN key — don't share one across deployments.
GROQ_API_KEY=
# Domain the SendGrid Inbound Parse route is configured on, e.g. track.example.com.
# Leave unset until that DNS/SendGrid setup is done.
INBOUND_EMAIL_DOMAIN=
# HTTP Basic Auth for the inbound webhook — SendGrid's own documented way to
# secure an Inbound Parse route. Embed these in the parse route's target URL:
# https://{user}:{password}@{api-host}/api/v1/emails/inbound
SENDGRID_INBOUND_USERNAME=
SENDGRID_INBOUND_PASSWORD=
# SendGrid *send* API key + a verified sender — needed to email saved-search
# job alerts and tester-feedback notifications. Unset means those emails are
# logged, not sent (everything else still works).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Where each tester-feedback submission is emailed (comma-separated for several
# inboxes), e.g. you@gmail.com. Needs the two SendGrid vars above; with them
# unset, submissions are still stored in Postgres — just not emailed.
FEEDBACK_NOTIFY_EMAIL=
